# ==============================================================
# BR FILMS — PUBLIC WEBSITE FRONTEND (.env.production / .env.local)
# Hosted independently (e.g. https://brfilms.in or Vercel / Netlify)
# ==============================================================

# Backend API Base URL (leave empty /api/v1 if reverse-proxied, or point to production API domain)
# Local: http://localhost:5000/api/v1
# Production: https://api.brfilms.in/api/v1
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Admin CMS Portal URL (used for links to the standalone admin portal)
# Local: http://localhost:5174
# Production: https://admin.brfilms.in
VITE_ADMIN_URL=http://localhost:5174
